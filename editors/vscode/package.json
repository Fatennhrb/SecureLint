{
  "name": "securelint",
  "displayName": "SecureLint",
  "description": "Security problems in your Python code, explained by Lint.",
  "version": "0.1.0",
  "publisher": "fatennhrb",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Fatennhrb/SecureLint"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "SecureLint runs a program on your files, so it only starts in folders you trust."
    }
  },
  "contributes": {
    "configuration": {
      "title": "SecureLint",
      "properties": {
        "securelint.executable": {
          "type": "string",
          "default": "securelint",
          "scope": "machine",
          "markdownDescription": "The SecureLint program to run, for example `securelint` or the full path to it. Only your own settings can change it, not a folder's settings."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "securelint",
          "title": "SecureLint",
          "icon": "media/lint-icon.svg"
        }
      ]
    },
    "views": {
      "securelint": [
        {
          "type": "webview",
          "id": "securelint.lint",
          "name": "Lint"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && mocha",
    "test:vscode": "npm run build && tsc -p tsconfig.test.json && vscode-test",
    "audit": "node scripts/audit.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --out securelint.vsix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "mocha": "12.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "@vscode/test-cli": {
      "mocha": "$mocha"
    }
  }
}
